# Copy to .env.local and fill in. Never commit .env.local.

# Convex — run `npx convex dev` once to create/link a project and print
# this URL (also generates convex/_generated/, required for the app to
# build at all).
NEXT_PUBLIC_CONVEX_URL=

# Clerk (clerk.com dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# NOT set here: CLERK_JWT_ISSUER_DOMAIN, used by convex/auth.config.ts to
# trust Clerk's tokens, lives in Convex's own environment instead of
# Next.js's — set it with:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
# (create a JWT template named "convex" in Clerk first; that page shows the
# issuer URL)

# Mastercard Open Banking — powers the bank search in "About You".
# See MASTERCARD_SETUP.md. Server-side only.
MASTERCARD_PARTNER_ID=
MASTERCARD_PARTNER_SECRET=
MASTERCARD_APP_KEY=
MASTERCARD_API_URL=https://api.finicity.com
